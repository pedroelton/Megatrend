//@version=6
strategy("Triple Supertrend Strategy", overlay=true, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Input for initial entry
enterAtStart = input.bool(true, "Enter Position at Start", tooltip="If true, enters based on initial trend. If false, waits for first trend shift.")

// Supertrend 1 (closest to price) - 10, 1
[st1, dir1] = ta.supertrend(1.0, 10)
st1 := barstate.isfirst ? na : st1

// Supertrend 2 (middle) - 11, 2
[st2, dir2] = ta.supertrend(2.0, 11)
st2 := barstate.isfirst ? na : st2

// Supertrend 3 (farthest from price) - 12, 3
[st3, dir3] = ta.supertrend(3.0, 12)
st3 := barstate.isfirst ? na : st3

// Plot Supertrends
plot(dir1 < 0 ? st1 : na, "ST1 Up", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(dir1 > 0 ? st1 : na, "ST1 Down", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)

plot(dir2 < 0 ? st2 : na, "ST2 Up", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(dir2 > 0 ? st2 : na, "ST2 Down", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)

plot(dir3 < 0 ? st3 : na, "ST3 Up", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(dir3 > 0 ? st3 : na, "ST3 Down", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)

// Detect trend flips
st1_flip_to_down = dir1 > 0 and dir1[1] < 0
st1_flip_to_up = dir1 < 0 and dir1[1] > 0

st2_flip_to_down = dir2 > 0 and dir2[1] < 0
st2_flip_to_up = dir2 < 0 and dir2[1] > 0

st3_flip_to_down = dir3 > 0 and dir3[1] < 0
st3_flip_to_up = dir3 < 0 and dir3[1] > 0

// Check if all lines are in same trend
all_uptrend = dir1 < 0 and dir2 < 0 and dir3 < 0
all_downtrend = dir1 > 0 and dir2 > 0 and dir3 > 0

// Track position state
var int positionState = 0  // 0 = no position, 1 = full long, 2 = 2/3 long, 3 = 1/3 long, -1 = full short, -2 = 2/3 short, -3 = 1/3 short
var bool hasEnteredFirstTrade = false

// Initial entry logic
if barstate.isconfirmed and not hasEnteredFirstTrade and enterAtStart
    if all_uptrend
        strategy.entry("Long", strategy.long)
        positionState := 1
        hasEnteredFirstTrade := true
    else if all_downtrend
        strategy.entry("Short", strategy.short)
        positionState := -1
        hasEnteredFirstTrade := true

// LONG ENTRY: All 3 lines flip to uptrend
if st3_flip_to_up and all_uptrend and positionState == 0
    strategy.entry("Long", strategy.long)
    positionState := 1
    hasEnteredFirstTrade := true

// SHORT ENTRY: All 3 lines flip to downtrend
if st3_flip_to_down and all_downtrend and positionState == 0
    strategy.entry("Short", strategy.short)
    positionState := -1
    hasEnteredFirstTrade := true

// LONG POSITION EXITS (close 1/3 as each line breaks down)
if positionState == 1 and st1_flip_to_down
    strategy.close("Long", qty_percent=33.33, comment="Close 1/3 Long")
    positionState := 2

if positionState == 2 and st2_flip_to_down
    strategy.close("Long", qty_percent=50, comment="Close 2/3 Long")
    positionState := 3

if positionState == 3 and st3_flip_to_down
    strategy.close("Long", qty_percent=100, comment="Close 3/3 Long")
    positionState := 0
    // Enter short when all lines flip
    if all_downtrend
        strategy.entry("Short", strategy.short)
        positionState := -1

// SHORT POSITION EXITS (close 1/3 as each line breaks up)
if positionState == -1 and st1_flip_to_up
    strategy.close("Short", qty_percent=33.33, comment="Close 1/3 Short")
    positionState := -2

if positionState == -2 and st2_flip_to_up
    strategy.close("Short", qty_percent=50, comment="Close 2/3 Short")
    positionState := -3

if positionState == -3 and st3_flip_to_up
    strategy.close("Short", qty_percent=100, comment="Close 3/3 Short")
    positionState := 0
    // Enter long when all lines flip
    if all_uptrend
        strategy.entry("Long", strategy.long)
        positionState := 1

// Visual indicators for position state
bgcolor(positionState == 1 ? color.new(color.green, 95) : positionState == 2 ? color.new(color.green, 97) : positionState == 3 ? color.new(color.green, 99) : na, title="Long Position")
bgcolor(positionState == -1 ? color.new(color.red, 95) : positionState == -2 ? color.new(color.red, 97) : positionState == -3 ? color.new(color.red, 99) : na, title="Short Position")